#!/usr/bin/env python3
"""Vendored Flash wrapper: --file only, no exec, idle does not kill, wall 6h."""
from __future__ import annotations

import argparse
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

WALL_SEC = float(os.environ.get("SPECTRE_DSH_WALL_SEC") or 6 * 3600)
KEY_FILE = Path(os.environ.get("SPECTRE_DSH_KEY") or Path.home() / ".config/fullmoon-agent-control/cline_api_key")
DSH_BIN = Path(os.environ.get("SPECTRE_DSH_BIN") or Path.home() / ".local/share/deepseek-harness-venv/bin/dsh")
DSH_HOME = Path(os.environ.get("SPECTRE_DSH_HOME") or Path.home() / ".local/share/fullmoon-dsh")


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="dsh-clinepass")
    parser.add_argument("--file", required=True, help="packet text path")
    args, unknown = parser.parse_known_args(argv)
    if unknown:
        raise SystemExit(2)
    return args


def write_exit(packet: Path, code: int) -> None:
    dest = packet.with_suffix(".exit")
    tmp = dest.with_suffix(".exit.tmp")
    tmp.write_text(f"{int(code)}\n", encoding="utf-8")
    tmp.replace(dest)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    packet = Path(args.file)
    if not packet.is_file():
        write_exit(packet, 2)
        return 2
    if not KEY_FILE.is_file() or oct(KEY_FILE.stat().st_mode)[-3:] != "600":
        write_exit(packet, 2)
        return 2
    task = packet.read_text(encoding="utf-8")
    env = os.environ.copy()
    env["DSH_HOME"] = str(DSH_HOME)
    env["DSH_TELEMETRY_MODE"] = "DISABLED"
    env["DSH_PERMISSION_MODE"] = "danger-full-access"
    env["CLINE_API_KEY"] = KEY_FILE.read_text(encoding="utf-8").strip()
    dsh = str(DSH_BIN)
    try:
        proc = subprocess.Popen(
            [dsh, "--profile", "headless", task],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        write_exit(packet, 127)
        return 127
    deadline = time.monotonic() + WALL_SEC
    while proc.poll() is None:
        if time.monotonic() >= deadline:
            proc.send_signal(signal.SIGTERM)
            try:
                proc.wait(timeout=8)
            except subprocess.TimeoutExpired:
                proc.kill()
            write_exit(packet, 124)
            return 124
        time.sleep(1)
    code = int(proc.returncode or 0)
    if code < 0:
        code = 1
    write_exit(packet, code)
    return code


if __name__ == "__main__":
    raise SystemExit(main())
