#!/usr/bin/env python3
"""Create private Go-proxy, free DSH, and Kimi client configuration."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import secrets
import sys

for parent in (Path(__file__).resolve().parent,
               Path(__file__).resolve().parent.parent / 'lib/spectre-worker-state',
               Path('/usr/local/lib/spectre-worker-state')):
    if (parent / 'control_plane').is_dir():
        sys.path.insert(0, str(parent))
        break

from control_plane import omni_setup


def main(argv=None) -> int:
    home = Path.home()
    parser = argparse.ArgumentParser()
    parser.add_argument('--credentials-file', type=Path, required=True)
    parser.add_argument('--paid-key', type=Path,
                        default=home / '.config/fullmoon-agent-control/cline_api_key')
    parser.add_argument('--kimi-config', type=Path,
                        default=home / '.kimi-code/config.toml')
    args = parser.parse_args(argv)
    key_file = home / '.config/omni-proxy/client_key'
    try:
        if key_file.exists():
            omni_setup.private_file(key_file)
            client_key = key_file.read_text(encoding='utf-8').strip()
        else:
            client_key = secrets.token_urlsafe(32)
        omni_setup.render_kimi(args.kimi_config, client_key)
        result = omni_setup.prepare(home, args.credentials_file, args.paid_key, client_key)
        omni_setup.configure_kimi(args.kimi_config, client_key)
        output = {'ok': True, 'config': result['config_path'],
                  'free_profile': result['free_profile_path'],
                  'kimi_config': str(args.kimi_config)}
    except (OSError, ValueError) as exc:
        output = {'ok': False, 'error': str(exc)}
    print(json.dumps(output, sort_keys=True))
    return 0 if output['ok'] else 1


if __name__ == '__main__':
    raise SystemExit(main())
