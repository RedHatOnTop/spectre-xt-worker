# Spectre agent community — Slack credentials and channel map.
# The real file lives ONLY at ~/.config/remote-agent/slack.env (mode 0600);
# it is never committed and never loaded into a process environment.
# Setup walkthrough: RUNBOOK.md §7.10.

# Bot token (xoxb-). Scopes: chat:write, chat:write.customize, channels:history
SLACK_BOT_TOKEN=

# App-level token (xapp-). Scope: connections:write (Socket Mode)
SLACK_APP_TOKEN=

# Channel IDs (C...) of the four community channels
SLACK_CHANNEL_ALERTS=
SLACK_CHANNEL_FLEET=
SLACK_CHANNEL_CONTROL=
SLACK_CHANNEL_LOBBY=

# Comma-separated Slack member IDs (U...) allowed to command the box in #control
SLACK_ALLOWED_USERS=

# Optional knobs (defaults shown)
# Auto-triage healthcheck alerts in-thread (1/0)
SLACK_TRIAGE=0
# #lobby two-voice debate: the antigravity CLI (agy) joins as second responder
# and responder posts draw the other voice, strictly alternating until [PASS]
# or a cap. Needs ~/.local/bin/agy and the read-only profile at
# ~/.gemini/antigravity-cli/settings.json (RUNBOOK 7.10). 0 = qoder-only.
SLACK_DEBATE=0
# Daily executor run budget across all channels
SLACK_MAX_RUNS_PER_DAY=30
# Lobby debate runs per day; also counted against the global cap above
SLACK_DEBATE_MAX_RUNS_PER_DAY=20
# Per-thread caps. Rolling-hour window: all channels. Per-day cap: debate-mode
# #lobby threads only (SLACK_DEBATE=1); debate off keeps the pre-debate budget
# exactly — hourly window + SLACK_MAX_RUNS_PER_DAY.
SLACK_THREAD_RUNS_PER_HOUR=4
SLACK_THREAD_TURNS_PER_DAY=8
# Executor: qodercli via the box-local cost-gated wrapper. The model is
# "efficient" (0-multiplier promo); changing it here bypasses nothing —
# the wrapper still refuses (exit 75) when the promo price is gone.
SLACK_EXECUTOR_BIN=~/.local/bin/qoder-efficient
SLACK_EXECUTOR_MODEL=efficient
# Second responder binary (absolute; only used when SLACK_DEBATE=1)
SLACK_AGY_BIN=~/.local/bin/agy
