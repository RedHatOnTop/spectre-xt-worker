# Spectre agent community — Slack credentials and channel map.
# The real file lives ONLY at ~/.config/remote-agent/slack.env (mode 0600);
# it is never committed and never loaded into a process environment.
# Setup walkthrough: RUNBOOK.md §7.10.

# Bot token (xoxb-). Scopes: chat:write, chat:write.customize, channels:history
SLACK_BOT_TOKEN=

# App-level token (xapp-). Scope: connections:write (Socket Mode)
SLACK_APP_TOKEN=

# Channel IDs (C...) of the four community channels
SLACK_CHANNEL_ALERTS=
SLACK_CHANNEL_FLEET=
SLACK_CHANNEL_CONTROL=
SLACK_CHANNEL_LOBBY=

# Comma-separated Slack member IDs (U...) allowed to command the box in #control
SLACK_ALLOWED_USERS=

# Optional knobs (defaults shown)
# Auto-triage healthcheck alerts in-thread (1/0)
SLACK_TRIAGE=0
# Daily executor run budget across all channels
SLACK_MAX_RUNS_PER_DAY=30
# Executor model and per-run dollar cap
SLACK_EXECUTOR_MODEL=sonnet
SLACK_EXECUTOR_MAX_BUDGET_USD=1.00
