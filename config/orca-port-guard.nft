#!/usr/sbin/nft -f
# Idempotent guard for the Orca serve port: loopback and tailscale0 only.
# The "table + delete table" prefix makes re-application safe.
table inet spectre_guard
delete table inet spectre_guard

table inet spectre_guard {
	chain input {
		type filter hook input priority filter; policy accept;
		iifname != { "lo", "tailscale0" } tcp dport 6768 counter drop
	}
}
