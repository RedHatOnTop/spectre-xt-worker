# Copy to ~/.config/remote-agent/lightning.env (chmod 600). Never commit the copy.
#
# Lightning AI free tier (RUNBOOK 7.21): one always-on 4-vCPU Studio, free,
# with a 4-hour session cap and a 10-minute idle auto-sleep that cannot be
# disabled on Free. Heavy builds/tests belong there, not on the Spectre.
#
# Credentials: the preferred home is the SDK's own file written by
# `lightning login` (~/.lightning/credentials.json, mode 600). Leave the two
# fields below empty unless explicit keys are needed; spectre-offload accepts
# either. Explicit keys come from lightning.ai -> profile -> Global Settings ->
# Keys -> "Programmatic access". An API key is a secret: reference it by name
# only, never paste it into the repo, Slack or a devlog.
LIGHTNING_USER_ID=
LIGHTNING_API_KEY=
# <owner>/<teamspace> as printed by `lightning studio list`; verified 2026-09-26
LIGHTNING_TEAMSPACE=person414213-q1op6/language-model
# Studio created once with `lightning studio create --name buildbox`
LIGHTNING_STUDIO=buildbox
# Machine enum name for `lightning studio start`; the free instance is 4 vCPU
LIGHTNING_MACHINE=CPU
# Optional CLI override; default resolves PATH, then the installer's venv
# LIGHTNING_BIN=/usr/local/lib/lightning-cli/venv/bin/lightning
# Remote sync root; empty means ~/offload/<repo basename>
LIGHTNING_WORKDIR=
# rsync excludes, space separated (keep build trees out of the upload)
LIGHTNING_EXCLUDES="build/ target/ node_modules/ .gradle/ .venv/"
# Where returned artifacts land on the Spectre
LIGHTNING_ARTIFACT_DIR=/home/person/.local/state/remote-agent/offload-artifacts
# Seconds to wait for the Studio to accept SSH after `studio start`
LIGHTNING_SSH_TIMEOUT=300
