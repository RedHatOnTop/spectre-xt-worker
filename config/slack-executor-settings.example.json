{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Bash(spectre-status)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log)",
      "Bash(systemctl --user is-active:*)",
      "Bash(systemctl --user status:*)",
      "Bash(ss -tln)",
      "Bash(tmux ls)",
      "Bash(df -h:*)",
      "Bash(free -h)",
      "Bash(uptime)"
    ],
    "deny": [
      "Grep",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/*.env*)",
      "Read(**/slack.env)",
      "Read(**/health.env)",
      "Read(**/env.json)",
      "Read(**/*token*)",
      "Read(**/http-token)",
      "Read(**/credentials.json)",
      "Read(**/.credentials.json)",
      "Read(**/hosts.yml)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.pem)",
      "Read(**/.ssh/**)",
      "Read(**/.config/remote-agent/**)",
      "Read(**/.qoder/**)",
      "Read(**/.claude/**)",
      "Read(**/.claude.json)",
      "Read(**/.gemini/**)",
      "Read(**/.codexpro/**)",
      "Read(**/.zcode/**)",
      "Read(**/.bash_history)",
      "Read(/work/hardened-zai-proxy/**)",
      "Read(/proc/**)",
      "Bash(journalctl:*)"
    ],
    "defaultMode": "default"
  }
}
