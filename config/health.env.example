# Copy to ~/.config/remote-agent/health.env and fill in. Never commit the copy.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
PROXY_HEALTH_URL=http://127.0.0.1:18088/health
TEMP_FAIL_C=85
DISK_FAIL_PCT=90
MEM_FLOOR_MB=800
SWAP_FAIL_PCT=90
# minutes between repeat alerts for an unchanged failure set
RENOTIFY_MIN=30
# Claude-Code worker box: glm-proxy and ZCode are optional.
REQUIRE_PROXY=1
REQUIRE_ZCODE=0
REQUIRE_CLAUDE=0
# orca serve (:6768) is the worker's main stack — required since 2026-09-12.
REQUIRE_ORCA=1
ORCA_URL=http://127.0.0.1:6768/web-index.html
# Slack alert backend (RUNBOOK 7.10). Independent of ntfy; the notifier
# prints "disabled" when slack.env is absent, so 0 is safe before setup.
REQUIRE_SLACK=0
# ChatGPT handoff bridge (codexpro on :8787, RUNBOOK 7.9). Off until installed.
REQUIRE_BRIDGE=0
BRIDGE_HEALTH_URL=http://127.0.0.1:8787/mcp
