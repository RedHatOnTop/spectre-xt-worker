{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Bash(spectre-status)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log)",
      "Bash(journalctl:*)",
      "Bash(systemctl --user is-active:*)",
      "Bash(systemctl --user status:*)",
      "Bash(pgrep:*)",
      "Bash(ss -tln)",
      "Bash(tmux ls)",
      "Bash(df:*)",
      "Bash(free:*)",
      "Bash(uptime)"
    ],
    "deny": [
      "Grep",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/slack.env)",
      "Read(**/health.env)",
      "Read(**/env.json)",
      "Read(**/http-token)",
      "Read(**/credentials.json)",
      "Read(**/.credentials.json)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.pem)",
      "Read(**/.ssh/**)",
      "Read(/work/hardened-zai-proxy/**)",
      "Read(/proc/*/environ)",
      "Read(/proc/**/environ)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/usr/local/share/remote-agent/slack-guard.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
