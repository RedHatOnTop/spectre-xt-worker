# CodexPro handoff bridge env (optional overrides).
# Copy to ~/.config/remote-agent/codexpro.env. Never commit the copy.
# Tokens never live here: they are 0600 files under ~/.codexpro
# (http-token, cloudflare-tunnel-token) referenced by --token-file paths.

# Extra blocked path globs for the file tools, comma-separated. The
# default blocklist already covers .env, .git internals, private keys,
# node_modules, and build caches — add repo-specific exclusions here.
#CODEXPRO_BLOCKED_GLOBS=**/secrets/**,**/*.sqlite,**/*.db

# Hard cap for the bash tool, ms. Only relevant once the unit runs
# --bash safe instead of --no-bash (default 600000, max 900000).
#CODEXPRO_MAX_BASH_TIMEOUT_MS=600000

# Approved HTTPS hosts for import_file (ChatGPT attachment downloads).
#CODEXPRO_IMPORT_ALLOWED_HOSTS=files.oaiusercontent.com

# Tool cards need a dedicated widget HTTPS origin; keep them off on the box.
CODEXPRO_TOOL_CARDS=0
