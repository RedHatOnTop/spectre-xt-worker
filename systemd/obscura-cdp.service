[Unit]
Description=Obscura headless browser — CDP server on 127.0.0.1:9222
After=network-online.target

[Service]
# Stealth build: rendering plus TLS impersonation and tracker blocking.
# --allow-private-network is for agent previews of local dev servers; the
# listener itself stays on loopback (obscura serve --host default).
ExecStart=/usr/local/bin/obscura serve --port 9222 --stealth --allow-private-network
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
