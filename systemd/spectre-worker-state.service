[Unit]
Description=Spectre authoritative worker-state resolver (shadow)
Documentation=file:///opt/spectre-xt-worker/RUNBOOK.md
# Shadow only (RUNBOOK 7.17): Slack / Grokbot / goal-watch still use the
# last-record classifier. This daemon records evidence, serves snapshots,
# and logs old-vs-new divergence. It does not type into workers.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/usr/local/bin/spectre-state serve
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=%h
# RUNBOOK 7.8 gotcha: user units inherit the lightdm/XFCE session env.
UnsetEnvironment=DESKTOP_SESSION XDG_CURRENT_DESKTOP XDG_SESSION_TYPE DISPLAY
NoNewPrivileges=true
Restart=always
RestartSec=3s

[Install]
WantedBy=default.target
